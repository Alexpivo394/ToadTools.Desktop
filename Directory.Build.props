<Project>

    <!-- Global build configuration -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <!-- Версия программы — версия релиза из тега (сборка передаёт VersionPrefix). Локальная сборка — 0.0.0,
         Debug-сборка сама себя не обновляет. -->
    <PropertyGroup>
        <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.0.0</VersionPrefix>
        <Company>ToadTools</Company>
        <Product>ToadTools</Product>
    </PropertyGroup>

    <!-- Polyfills configuration -->
    <PropertyGroup>
        <PolyArgumentExceptions>true</PolyArgumentExceptions>
    </PropertyGroup>

    <!-- Global usings -->
    <ItemGroup>
        <Using Include="JetBrains.Annotations"/>
    </ItemGroup>

</Project>
