<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Перо и сенсорный ввод программе в трее не нужны, а служба пера WPF (TabletPenServiceHelper) может не дать
         процессу завершиться, если при выходе было открыто меню значка -->
    <AppContextSwitchOverrides value="Switch.System.Windows.Input.Stylus.DisableStylusAndTouchSupport=true" />
  </runtime>
</configuration>
